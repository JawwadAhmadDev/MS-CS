        <color id="ID1412327120">
          <id>checkRainfall</id>
          <enum>
            <id>Rainfall</id>
            <id>StorageCapacity</id>
          </enum>
          <layout>colset checkRainfall= with Rainfall|StorageCapacity;</layout>
        </color>
        <color id="ID1412327844">
          <id>checkwaterlevel</id>
          <enum>
            <id>waterlevel</id>
            <id>waterflow</id>
          </enum>
          <layout>colset checkwaterlevel= with waterlevel|waterflow;</layout>
        </color>
        <color id="ID1414259005">
          <id>checkdirection</id>
          <enum>
            <id>waterdirection</id>
            <id>speed</id>
          </enum>
          <layout>colset checkdirection=with waterdirection|speed;</layout>
        </color>
        <color id="ID1412328114">
          <id>warning</id>
          <product>
            <id>checkRainfall</id>
            <id>checkwaterlevel</id>
            <id>checkdirection</id>
          </product>
          <layout>colset warning= product checkRainfall*checkwaterlevel*checkdirection;</layout>
        </color>
        <color id="ID1414260511">
          <id>prevention</id>
          <product>
            <id>checkRainfall</id>
            <id>checkwaterlevel</id>
            <id>checkdirection</id>
          </product>
          <layout>colset prevention= product checkRainfall*checkwaterlevel*checkdirection;</layout>
        </color>
        <color id="ID1414262010">
          <id>AlertToGeneralPublic</id>
          <product>
            <id>warning</id>
            <id>prevention</id>
          </product>
          <layout>colset AlertToGeneralPublic= product warning*prevention;</layout>
        </color>
